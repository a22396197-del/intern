# =====================================================================
# Free Intern — Environment Configuration
# =====================================================================

# GEMINI_API_KEY (Optional):
# Your Google Gemini AI API key from Google AI Studio (https://aistudio.google.com/app/apikey).
# If provided, enables live generative AI for resume analysis, personalized recommendations,
# and mock interview feedback.
# If omitted, Free Intern operates seamlessly with built-in deterministic algorithms.
#
# For Local Development:
# Set this in your local .env file:
# GEMINI_API_KEY=AIzaSy...
#
# For Vercel Deployment:
# Add this in Vercel Project Settings -> Environment Variables -> Key: GEMINI_API_KEY
GEMINI_API_KEY=

# PORT (Optional, default 3000):
# Port for the local development server.
# If port 3000 is occupied, the server automatically finds and binds to the next available port.
PORT=3000

# NODE_ENV (development | production)
NODE_ENV=development
